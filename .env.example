# Foreman — environment
#
# Copy to `.env` for local development. Every variable the app reads is
# declared in `src/lib/env.ts`; if you add one here, add it there too.
#
# The list is short on purpose. Dropping Supabase, both OAuth providers and the
# calendar sync took nineteen variables with them.

# ── Required ──────────────────────────────────────────────────────────────────

# Absolute, no trailing slash. Used to build the crew's read-only link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Access ────────────────────────────────────────────────────────────────────

# The one passcode. Minimum 16 characters — it is the only thing between a
# public URL and a button that emails subcontractors, so make it a passphrase
# rather than a word. Required in production; leave it unset locally and the
# app runs ungated for convenience.
#
#   ADMIN_PASSCODE=cold-slab-tuesday-rebar
ADMIN_PASSCODE=

# Signs the "remember this device" cookie. Rotating it signs everyone out.
#   openssl rand -base64 32
SESSION_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────

# Vercel Blob holds the whole schedule as one JSON document.
#
# Leave unset locally: the app falls back to `data/schedule.json` on disk, so a
# fresh clone runs with no setup at all.
#
# REQUIRED on Vercel. A serverless function's filesystem is discarded between
# invocations, so without this every change is silently lost. Create the store
# in the Vercel dashboard (Storage → Create → Blob) and it injects this for you.
BLOB_READ_WRITE_TOKEN=

# ── Voice ─────────────────────────────────────────────────────────────────────

# Whisper for speech, GPT for turning it into a proposal. Without a key the
# microphone and the assistant are unavailable; everything else still works.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_PLANNER_MODEL=gpt-4o

# ── Email ─────────────────────────────────────────────────────────────────────

# Resend sends the "your dates changed" notes.
#
# Leave unset and the app uses its console driver: messages are composed,
# recorded against the change, shown in History, and never sent. That is the
# right default — this schedule is full of real subcontractors.
RESEND_API_KEY=

# Must be on a domain verified with Resend, or every send bounces.
#   MAIL_FROM=schedule@yourdomain.com
MAIL_FROM=

# Where a subcontractor's reply should land. Without it, replies go to the
# sending domain and nobody reads them.
MAIL_REPLY_TO=

# Off composes and records notifications but sends nothing, whatever the key
# says — the switch for a dry run against real data.
FEATURE_SEND_EMAIL=true
