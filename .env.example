##############################################################################
# FOREMAN — environment (example)
#
# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# Next.js on Vercel · Supabase (Postgres + Auth + RLS) · OpenAI · Microsoft Graph
#
# NEXT_PUBLIC_* is compiled into the browser bundle. Everything else is
# server-only and must never be prefixed with NEXT_PUBLIC_.
##############################################################################


# ─────────────────────────────────────────────────────────────────────────────
# 1. APP
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# 32-byte key used to encrypt Microsoft refresh tokens at rest (AES-256-GCM).
# Generate:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Bearer token protecting internal cron endpoints from public access.
# Generate:  openssl rand -hex 32
CRON_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# 2. SUPABASE
# Dashboard ▸ Project Settings ▸ API Keys  (use the API Keys tab, not Legacy)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Bypasses RLS. Server-side only — never in client code, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Postgres connections (Settings ▸ Database ▸ Connection string).
#
# Both go through the *pooler* host. The legacy direct host,
# db.<project-ref>.supabase.co, no longer resolves over IPv4 — if you copy that
# one you get `getaddrinfo ENOTFOUND` from the CLI and from psql.
#
#   DATABASE_URL : port 6543, transaction mode — the app. Serverless-safe.
#   DIRECT_URL   : port 5432, session mode     — migrations (`pnpm db:push`).
#
# Same host and password for both; only the port differs.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres


# ─────────────────────────────────────────────────────────────────────────────
# 3. OPENAI
# platform.openai.com ▸ API keys
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx

# Speech-to-text for the push-to-talk mic.
OPENAI_STT_MODEL=whisper-1

# Reasoning model that turns a transcript into schedule operations.
OPENAI_PLANNER_MODEL=gpt-4o


# ─────────────────────────────────────────────────────────────────────────────
# 4. MICROSOFT GRAPH — Outlook mail + calendar
# Entra admin center ▸ App registrations ▸ New registration
#   Supported account types : multitenant + personal Microsoft accounts
#   Redirect URI (Web)      : {APP_URL}/api/microsoft/callback
#   Certificates & secrets  : new client secret → copy the VALUE, not the ID
#   API permissions (delegated, all self-consentable):
#     Mail.Send  Calendars.ReadWrite  User.Read  offline_access
#     Mail.Send.Shared     ← only if sending from a shared mailbox
# ─────────────────────────────────────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/api/microsoft/callback
# Quoted: the value contains spaces, and an unquoted one breaks every
# dotenv-style parser that reads this file (the Supabase CLI among them).
MS_SCOPES="offline_access User.Read Mail.Send Calendars.ReadWrite"


# ─────────────────────────────────────────────────────────────────────────────
# 5. FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
# Read the parsed plan back and require a tap before anything sends. Keep true.
FEATURE_CONFIRM_BEFORE_SEND=true

# Add subs as calendar-event attendees so accept/decline flows back to you.
FEATURE_INVITE_ATTENDEES=true

# One-way sync only (app is source of truth). Two-way needs Graph change
# notifications + subscription renewal — out of scope for v1.
FEATURE_TWO_WAY_CALENDAR_SYNC=false


# ─────────────────────────────────────────────────────────────────────────────
# 6. OPTIONAL — add when you have a real user, not before
# ─────────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
